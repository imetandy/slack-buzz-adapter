# Slack credentials. Never commit real tokens.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Required fail-closed source policy. Use stable Slack IDs, never names, as the
# authorization boundary. The optional name denylist is defense in depth.
SLACK_ALLOWED_CHANNEL_IDS=C0123456789,G0123456789
# SLACK_DENIED_CHANNEL_NAMES=partners,board-meeting,finance-leads

# Optional prefix for created/reconciled Buzz channel names.
# BUZZ_CHANNEL_PREFIX=mlf-

# One-to-one Slack -> Buzz routing file.
CHANNEL_MAPPINGS_PATH=channel-mappings.json

# Buzz CLI authentication. BUZZ_AUTH_TAG is optional for message publishing.
BUZZ_RELAY_URL=https://endcorp.communities.buzz.xyz
BUZZ_PRIVATE_KEY=nsec1...
# BUZZ_AUTH_TAG=["auth","..."]

# Optional settings.
# BUZZ_CLI=buzz
# STATE_PATH=.data/state.json
# SYNC_STATE_PATH=.data/channel-sync-state.json
# ROUTE_REFRESH_HASH_PATH=.data/channel-sync-applied-hash
# CHANNEL_SYNC_INTERVAL_MS=60000
# ADAPTER_LABEL=Slack mirror
# LOG_LEVEL=info

# `npm run sync-channels` creates private Buzz mirrors, makes this human an
# owner, and adds the listed agents as bots. The copilot identity values below
# are used as fallbacks when these are omitted.
# MIRROR_OWNER_PUBKEY=<hex-pubkey>
# MIRROR_AGENT_PUBKEYS=<hex-pubkey>,<hex-pubkey>

# Optional backfill lower bound. Accepts an ISO-8601 date or Slack timestamp.
# Blank means all accessible channel history.
# BACKFILL_OLDEST=2026-01-01T00:00:00Z

# Optional one-human copilot pilot. These two values enable the dedicated
# Slack App Home DM -> private Buzz copilot channel route.
# COPILOT_SLACK_USER_ID=U0123456789
# COPILOT_BUZZ_CHANNEL_ID=00000000-0000-0000-0000-000000000000
# COPILOT_AGENT_NAME=Andrew's Research Copilot

# Automatic private reply delivery. The worker requires the configured agent
# to reply to a Slack-originated request from the paired Buzz human, and
# requires the response to include a Slack source permalink.
# COPILOT_AGENT_PUBKEY=<hex-pubkey>
# COPILOT_HUMAN_PUBKEY=<hex-pubkey>
# COPILOT_STATE_PATH=.data/copilot-state.json
# COPILOT_POLL_INTERVAL_MS=10000
